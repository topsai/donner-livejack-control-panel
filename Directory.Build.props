<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>topsai (范斯特洛夫斯基)</Authors>
    <Company>topsai (范斯特洛夫斯基)</Company>
    <RepositoryUrl>https://github.com/topsai/donner-livejack-control-panel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(SelfContained)' == 'true'">
    <!-- WPF and WinForms include English in their neutral assemblies. -->
    <SatelliteResourceLanguages>zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
