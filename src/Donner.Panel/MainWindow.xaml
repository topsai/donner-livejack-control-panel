<Window x:Class="Donner.Panel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Donner.Panel" Title="Donner 中文控制面板" Icon="Assets/donner.ico" Width="900" Height="620" MinWidth="840" MinHeight="600" Background="#F2F5F7" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterScreen">
 <Grid Background="#F2F5F7"><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#142A34"><Grid Margin="22,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/donner-logo.png" Width="50" Height="50" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="DONNER / LIVEJACK" FontSize="13" Foreground="#89CABB" FontWeight="SemiBold"/><TextBlock Text="中文音频控制中心" FontSize="21" FontWeight="SemiBold" Foreground="White" Margin="0,5,0,0"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="DeviceStatus" Text="正在检测设备…" FontSize="16" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/><TextBlock x:Name="DeviceSubtitle" Text="" Foreground="#A7C6D1" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="DetectButton" Content="重新检测" Click="DetectClick" Background="#26424B" Foreground="White" Margin="0,0,12,0" Padding="10,8"/>
    <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="38" Height="38" Padding="8" Margin="0" Background="#26424B" Foreground="White" ToolTip="设置与其他页面" Click="GearClick"><Button.ContextMenu><ContextMenu x:Name="PagesMenu"><MenuItem Header="设备控制" Tag="0" Click="PageClick"/><Separator/><MenuItem Header="配置预设" Tag="1" Click="PageClick"/><MenuItem Header="设备诊断" Tag="2" Click="PageClick"/><MenuItem Header="应用设置" Tag="3" Click="PageClick"/><MenuItem Header="面板说明" Tag="4" Click="PageClick"/><Separator/><MenuItem Header="关于" Tag="5" Click="PageClick"/><MenuItem Header="驱动设置" Tag="6" Click="PageClick"/></ContextMenu></Button.ContextMenu></Button>
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="16,12">
   <TabControl x:Name="Pages" SelectedIndex="0" BorderThickness="0" Background="White"><TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="{TemplateBinding Background}"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></ControlTemplate></TabControl.Template>
    <TabItem Header="设备控制"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="12,12"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Background="#F8FAFB" BorderBrush="#E3E9ED" BorderThickness="1" CornerRadius="8" Padding="14" VerticalAlignment="Top"><StackPanel>
      <TextBlock x:Name="AudioTitle" Text="音频设置" FontSize="18" FontWeight="SemiBold"/>
      <StackPanel x:Name="RateSection" Margin="0,20,0,20"><TextBlock Text="采样率" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="RateCombo" DisplayMemberPath="Label"/><Button x:Name="RateApply" Content="应用" Click="RateClick" Style="{StaticResource Primary}" Margin="0"/></StackPanel></StackPanel>
      <StackPanel x:Name="BufferSection"><TextBlock Text="ASIO 缓冲（samples）" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="BufferCombo"/><Button x:Name="BufferApply" Content="应用" Click="BufferClick" Style="{StaticResource Primary}" Margin="0"/></StackPanel></StackPanel>
      <StackPanel x:Name="LatencySection" Margin="0,20,0,0"><TextBlock x:Name="InputLatencyText" Foreground="#425D6B" ToolTip="ASIO 驱动报告的输入延迟"/><TextBlock x:Name="OutputLatencyText" Foreground="#425D6B" Margin="0,10,0,0" ToolTip="ASIO 驱动报告的输出延迟"/></StackPanel>
     </StackPanel></Border>
     <Border Grid.Column="2" Background="#F8FAFB" BorderBrush="#E3E9ED" BorderThickness="1" CornerRadius="8" Padding="14" VerticalAlignment="Top"><StackPanel>
      <Border x:Name="ChannelHeader"><StackPanel><TextBlock Text="通道音量" FontSize="18" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,6"><CheckBox x:Name="LinkedCheck" Content="左右输出联动" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" Click="LinkedClick"/><CheckBox x:Name="MeterCheck" Content="实时电平" IsChecked="True" Click="MeterCheckClick" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="MuteAllButton" Content="输出全部静音" Click="MuteAllClick" Margin="0"/></WrapPanel></StackPanel></Border>
      <UniformGrid x:Name="ChannelsPanel" Rows="1" Margin="0,8,0,0"/>
     </StackPanel></Border>
    </Grid></ScrollViewer></TabItem>
    <TabItem Header="配置预设"><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="我的预设" FontSize="18" FontWeight="SemiBold"/><ListBox x:Name="PresetsList" DisplayMemberPath="Name" Height="260" Margin="0,16,0,12" SelectionChanged="PresetSelected"/><Button Content="删除所选预设" Click="DeletePresetClick" HorizontalAlignment="Left"/><Button Content="打开预设目录" Click="OpenPresetsClick" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock Text="预设保存在当前用户目录。损坏文件会报告错误，可在目录中处理。" Foreground="#657887" Margin="0,18,0,0"/></StackPanel></ScrollViewer><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="保存当前设备设置" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="PresetName" Margin="0,16,0,12" MaxLength="60" Text="日常使用"/><Button x:Name="SavePresetButton" Content="保存预设" Style="{StaticResource Primary}" Click="SavePresetClick" HorizontalAlignment="Left"/><TextBlock Text="应用预设" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,12"/><TextBlock x:Name="PresetPreview" Text="从左侧选择预设，检查内容后点击应用。" Foreground="#657887"/><Button x:Name="ApplyPresetButton" Content="应用所选预设" Click="ApplyPresetClick" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Grid></TabItem>
    <TabItem Header="设备诊断"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button Content="复制诊断摘要" Click="CopyClick"/><Button Content="导出日志" Click="ExportClick"/><Button Content="打开日志目录" Click="OpenLogsClick"/></StackPanel><TextBox x:Name="DiagnosticsText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" Background="#F8FAFB"/></Grid></TabItem>
    <TabItem Header="应用设置"><StackPanel Margin="24,20"><TextBlock Text="启动设置" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="StartupCheck" Content="随 Windows 启动" Margin="0,18,0,10" Click="StartupClick"/><TextBlock Text="登录 Windows 后在托盘运行，并自动连接声卡。双击托盘图标可打开控制面板。" Foreground="#657887"/></StackPanel></TabItem>
    <TabItem Header="面板说明"><local:FrontPanelGuide x:Name="PanelGuide"/></TabItem>
    <TabItem Header="关于"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20">
     <StackPanel Orientation="Horizontal"><Image Source="Assets/donner-logo.png" Width="64" Height="64" Margin="0,0,16,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Donner 中文控制面板" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="AboutVersion" Foreground="#657887" Margin="0,6,0,0"/></StackPanel></StackPanel>
     <TextBlock Margin="0,24,0,0">作者：<Hyperlink NavigateUri="https://github.com/topsai" RequestNavigate="ProjectLinkClick">topsai (范斯特洛夫斯基)</Hyperlink></TextBlock>
     <TextBlock Margin="0,16,0,0" TextWrapping="Wrap">GitHub：<Hyperlink NavigateUri="https://github.com/topsai/donner-livejack-control-panel" RequestNavigate="ProjectLinkClick">github.com/topsai/donner-livejack-control-panel</Hyperlink></TextBlock>
     <TextBlock Margin="0,16,0,0"><Hyperlink NavigateUri="https://github.com/topsai/donner-livejack-control-panel/releases/latest" RequestNavigate="ProjectLinkClick">下载最新版本</Hyperlink><Run Text="    ·    "/><Hyperlink NavigateUri="https://github.com/topsai/donner-livejack-control-panel/issues" RequestNavigate="ProjectLinkClick">反馈问题</Hyperlink></TextBlock>
     <TextBlock Text="适用于 Donner Livejack 的非官方中文控制面板。原厂驱动由 Donner / Thesycon 提供。" Foreground="#657887" TextWrapping="Wrap" Margin="0,24,0,0"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="驱动设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20">
     <TextBlock Text="原厂驱动设置" FontSize="18" FontWeight="SemiBold"/>
     <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock x:Name="DriverStateText" TextWrapping="Wrap" Foreground="#425D6B"/>
     <StackPanel Grid.Column="2">
     <StackPanel x:Name="OutputFormatSection"><TextBlock Text="输出位深" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="OutputFormatCombo" DisplayMemberPath="Label"/><Button x:Name="OutputFormatApply" Content="应用" Click="OutputFormatClick" Style="{StaticResource Primary}"/></StackPanel></StackPanel>
     <CheckBox x:Name="SafeModeCheck" Content="ASIO 安全模式" Margin="0,20,0,0" ToolTip="使用原厂驱动的额外缓冲提高稳定性，可能增加延迟。" Click="SafeModeClick"/>
     <StackPanel x:Name="StreamModeSection" Margin="0,20,0,0"><TextBlock Text="音频流模式" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="StreamModeCombo" DisplayMemberPath="Label"/><Button x:Name="StreamModeApply" Content="应用" Click="StreamModeClick" Style="{StaticResource Primary}"/></StackPanel><TextBlock Text="按需开启：音频软件使用时启动。持续开启：保持声卡音频流运行。" Foreground="#657887" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
     </StackPanel></Grid>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
  </Grid>
  <Border Grid.Row="2" Background="#E5EDF0" Padding="16,8"><TextBlock x:Name="Feedback" Text="快捷键：F5 重新检测 · Ctrl+S 保存预设 · Ctrl+M 输出静音" Foreground="#425D6B"/></Border>
 </Grid>
</Window>
