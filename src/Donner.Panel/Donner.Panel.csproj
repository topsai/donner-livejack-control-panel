<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><PlatformTarget>x64</PlatformTarget><AssemblyName>DonnerControlPanel</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest><Version>1.17.0</Version><ApplicationIcon>Assets/donner.ico</ApplicationIcon></PropertyGroup>
  <ItemGroup><Resource Include="Assets/donner-logo.png" /><Resource Include="Assets/donner.ico" /><Resource Include="Assets/front-panel.jpg" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Donner.Core/Donner.Core.csproj" /><ProjectReference Include="../Donner.Host/Donner.Host.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /><Using Include="System.IO" /></ItemGroup>
  <!-- WPF owns startup and DPI. WinForms is used only for NotifyIcon, not a Form. -->
  <PropertyGroup><NoWarn>$(NoWarn);WFO0003</NoWarn></PropertyGroup>
  <Target Name="CopyDeviceHost" AfterTargets="Build"><ItemGroup><DeviceHostFiles Include="../Donner.Host/bin/$(Configuration)/net10.0-windows/*" /></ItemGroup><Copy SourceFiles="@(DeviceHostFiles)" DestinationFolder="$(OutDir)" /></Target>
</Project>
